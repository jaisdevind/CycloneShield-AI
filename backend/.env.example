# Environment Variables for CycloneShield AI Backend

HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Google Gemini API (Get key from https://aistudio.google.com/)
# Leave blank to run with transparent deterministic fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Earth Engine (Optional)
# If left blank, CycloneShield AI uses built-in high-resolution screening datasets
EE_PROJECT_ID=
EE_SERVICE_ACCOUNT_EMAIL=
EE_PRIVATE_KEY_PATH=

# Meteorological Service
WEATHER_PROVIDER_MODE=demo

# Database
DATABASE_URL=sqlite:///./cycloneshield.db

# Default Region Configuration
DEFAULT_REGION_ID=andhra_pradesh
DEFAULT_REGION_NAME="Coastal Andhra Pradesh, India"
